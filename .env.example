# Copie para .env e preencha com as credenciais do seu projeto Supabase
# (Dashboard > Project Settings > API)
#
# Funciona com qualquer um destes padrões de nome:
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui

# ...ou com o prefixo do Vite:
# VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Sessão persistente via cookie HttpOnly (refresh token) — RECURSO OPCIONAL.
# Requer Cloudflare Pages com a função em functions/api/auth.js (GitHub Pages
# NÃO executa Pages Functions). Deixe desligado (ou ausente) no GitHub Pages:
# VITE_GG_SESSION_COOKIE=true
