# URL base da API (Cloudflare Worker em backend/).
# Copie para .env e ajuste:
#   dev:        http://127.0.0.1:8787  (padrão do `wrangler dev`)
#   produção:   https://gente-gestao-api.SEU-SUBDOMINIO.workers.dev
VITE_API_BASE=http://127.0.0.1:8787

# As credenciais do CockroachDB e o segredo do JWT pertencem ao Worker e
# ficam em backend/.dev.vars (local) ou nos secrets do Cloudflare (produção).
# Veja backend/.dev.vars.example.
