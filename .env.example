# URL base da API (Cloudflare Worker em backend-sheets/).
#
# IMPORTANTE: use SEMPRE a URL completa, com o esquema (https://).
# Sem o esquema, o navegador trata o valor como caminho relativo do domínio
# atual e o login cai no Cloudflare Pages (erro 405).
#
#   dev:       http://127.0.0.1:8787
#   produção:  https://gente-gestao-api-sheets.SEU-SUBDOMINIO.workers.dev
VITE_API_URL=http://127.0.0.1:8787

# Compatibilidade: o código também aceita VITE_API_BASE (mesmo formato).
# VITE_API_BASE=https://gente-gestao-api-sheets.SEU-SUBDOMINIO.workers.dev
