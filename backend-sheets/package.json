{
  "name": "gente-gestao-api-sheets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend do Dashboard People Analytics usando Google Sheets como banco (Cloudflare Workers + Hono + TypeScript)",
  "scripts": {
    "dev": "wrangler dev",
